# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file — it's already in .gitignore.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-3.6-flash if not set.
GEMINI_MODEL=gemini-3.6-flash

# Any random string — used to sign Flask session cookies.
FLASK_SECRET_KEY=change-me-to-something-random

# How many wrong ID-number attempts are allowed before the chat locks.
MAX_VERIFY_ATTEMPTS=3

# Flask debug mode (turn off in production).
FLASK_DEBUG=1
